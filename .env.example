# PostgreSQL (obligatorio para auth y clientes)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Sesión y cifrado de claves streaming
AUTH_SECRET="cambia-esto-por-un-string-largo"
CREDENTIALS_SECRET="otro-secreto-para-cifrar-claves"

# Canal de WhatsApp: green-api | meta | wa-me
WHATSAPP_PROVIDER=green-api

# Green API (desarrollo / demos)
GREEN_API_URL=https://api.green-api.com
GREEN_API_INSTANCE_ID=1101xxxxxxxx
GREEN_API_TOKEN=your_api_token_instance

# Meta Cloud API (producción futura)
# WHATSAPP_PROVIDER=meta
# META_WHATSAPP_TOKEN=
# META_PHONE_NUMBER_ID=
